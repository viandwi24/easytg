{
  "name": "@easytg/simulator",
  "version": "0.6.0",
  "description": "A Telegram that lives in memory: a Bot API your grammY bot talks to, simulated users, and a Telegram-like chat window. No token, no network.",
  "license": "MIT",
  "author": "viandwi24",
  "homepage": "https://github.com/viandwi24/easytg/blob/main/docs/simulator.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viandwi24/easytg.git",
    "directory": "packages/simulator"
  },
  "bugs": {
    "url": "https://github.com/viandwi24/easytg/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "workerd": "./dist/browser/index.js",
      "worker": "./dist/browser/index.js",
      "browser": "./dist/browser/index.js",
      "default": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "bun": "./src/element.ts",
      "workerd": "./dist/browser/element.js",
      "worker": "./dist/browser/element.js",
      "browser": "./dist/browser/element.js",
      "default": "./dist/element.js"
    },
    "./load": {
      "types": "./dist/load.d.ts",
      "bun": "./src/load.ts",
      "default": "./dist/load.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "telegram",
    "bot",
    "grammy",
    "simulator",
    "testing",
    "bot-api"
  ],
  "peerDependencies": {
    "grammy": "^1.30.0"
  },
  "engines": {
    "node": ">=20"
  }
}
