{
  "name": "@easytg/studio",
  "version": "0.6.0",
  "description": "A Telegram for developing bots: your bot (any language) against a simulated Telegram in the browser, with profiles, chats, groups, channels and topics, the bot's output, every Bot API call, its flow map and recorded tests. Restarts on file changes.",
  "license": "MIT",
  "author": "viandwi24",
  "homepage": "https://github.com/viandwi24/easytg/blob/main/packages/studio/README.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viandwi24/easytg.git",
    "directory": "packages/studio"
  },
  "bugs": {
    "url": "https://github.com/viandwi24/easytg/issues"
  },
  "type": "module",
  "bin": {
    "easytg-studio": "./src/cli.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "telegram",
    "bot",
    "simulator",
    "devtools",
    "grammy",
    "bot-api"
  ],
  "dependencies": {
    "@easytg/simulator": "0.6.0",
    "grammy": "^1.30.0"
  },
  "engines": {
    "bun": ">=1.1"
  }
}
