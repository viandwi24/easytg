{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "types": ["bun"],

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // The workspace packages, from source (their builds point "types" at dist/).
    "paths": {
      // easytg itself, as code outside src/ imports it (scripts/hero/bot.ts), so it resolves without a build.
      "easytg": ["./src/index.ts"],
      "@easytg/simulator": ["./packages/simulator/src/index.ts"],
      "@easytg/simulator/*": ["./packages/simulator/src/*.ts"],
      "@easytg/studio": ["./packages/studio/src/index.ts"]
    }
  },
  "include": ["src", "test", "examples", "scripts", "packages/*/src"]
}
