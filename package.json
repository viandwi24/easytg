{
  "name": "easytg",
  "version": "0.3.0",
  "description": "Page-based Telegram bot UIs on top of grammY: one page definition, rendered the same whether it is sent, replied or edited.",
  "license": "MIT",
  "author": "viandwi24",
  "homepage": "https://github.com/viandwi24/easytg#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viandwi24/easytg.git"
  },
  "bugs": {
    "url": "https://github.com/viandwi24/easytg/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "browser": "./dist/browser/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "bun": "./src/testing.ts",
      "browser": "./dist/browser/testing.js",
      "default": "./dist/testing.js"
    },
    "./simulator": {
      "types": "./dist/simulator/index.d.ts",
      "bun": "./src/simulator/index.ts",
      "browser": "./dist/browser/simulator/index.js",
      "default": "./dist/simulator/index.js"
    },
    "./simulator/element": {
      "types": "./dist/simulator/element.d.ts",
      "bun": "./src/simulator/element.ts",
      "browser": "./dist/browser/simulator/element.js",
      "default": "./dist/simulator/element.js"
    }
  },
  "files": [
    "dist",
    "src",
    "docs",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "telegram",
    "bot",
    "grammy",
    "ui",
    "inline-keyboard",
    "dialogue",
    "simulator"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun run scripts/build.ts",
    "docs:dev": "bun --bun vitepress dev website",
    "docs:build": "bun --bun vitepress build website",
    "docs:preview": "bun --bun vitepress preview website",
    "example:captcha": "bun run examples/captcha.ts",
    "prepublishOnly": "bun run typecheck && bun test && bun run build",
    "example:notify": "bun run examples/notify.ts",
    "release": "bun run scripts/release.ts"
  },
  "peerDependencies": {
    "grammy": "^1.30.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@types/bun": "latest",
    "codemirror": "^6.0.2",
    "grammy": "^1.46.0",
    "sucrase": "^3.35.1",
    "typescript": "^7",
    "vitepress": "^1.6.4"
  }
}
